{
  "name": "inkforge-windows-ui",
  "description": "墨境 Windows 本地优先 AI 小说创作工具",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "backend": "python backend/main.py 8765",
    "dev:ui": "vite --host 127.0.0.1",
    "dev": "concurrently -k -n backend,ui \"npm:backend\" \"npm:dev:ui\"",
    "desktop": "node electron/dev.cjs",
    "build": "tsc && vite build",
    "backend:dist": "pyinstaller backend/mojing-backend.spec --noconfirm --distpath backend/dist --workpath backend/build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pytest backend/tests -q",
    "test:backend": "pytest backend/tests -q",
    "lint": "eslint src",
    "pack": "npm run build && npm run backend:dist && electron-builder --dir",
    "dist": "npm run build && npm run backend:dist && electron-builder --win --x64 --publish always",
    "gen:types": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.0"
  },
  "build": {
    "appId": "com.mojing.writer",
    "productName": "墨境",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "mojing-backend.exe",
          "mojing-backend"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "dvadac6-alt",
      "repo": "AI-write"
    }
  }
}
