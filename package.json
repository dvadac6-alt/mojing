{
  "name": "inkforge-windows-ui",
  "description": "墨境 Windows 本地优先 AI 小说创作工具",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "backend": "python backend/main.py 8765",
    "dev:ui": "vite --host 127.0.0.1 --port 5175",
    "dev": "concurrently -k -n backend,ui \"npm:backend\" \"npm:dev:ui\"",
    "desktop": "node electron/dev.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "10.0.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "vite": "8.2.0"
  },
  "build": {
    "appId": "com.mojing.writer",
    "productName": "墨境",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["electron/**/*", "backend/**/*", "!backend/data/**/*", "!backend/**/__pycache__/**/*", "dist/**/*", "package.json"],
    "extraMetadata": { "main": "electron/main.cjs" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
