# 墨境 AI 服务配置模板
# 复制本文件为 .env 并填写（.env 已被 .gitignore 排除，不会提交到仓库）。
# 后端每次启动时读取，API Key 会经 Fernet 加密后存入数据库配置
# （设置 → AI 模型 中可见、可继续修改），调用 AI 时解密使用。

# 服务商标识：openai / deepseek / 其他兼容 OpenAI 格式的服务
MOJING_AI_PROVIDER=openai

# API 地址（OpenAI 兼容格式）
MOJING_AI_BASE_URL=https://api.openai.com/v1

# 模型名
MOJING_AI_MODEL=gpt-4o-mini

# API Key（必填；留空则忽略整个 env 配置）
MOJING_AI_API_KEY=sk-your-key-here

# 可选：配置显示名称
# MOJING_AI_NAME=默认模型
